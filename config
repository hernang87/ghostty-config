# Generated by iterm2_to_ghostty.py
# Source iTerm2 profile: Default
# Review warnings/comments before replacing an existing hand-written Ghostty config.

theme = light:iterm2-Default-light,dark:iterm2-Default-dark
font-family = Monaco
font-family = Menlo
font-size = 14
font-thicken = true
window-padding-x = 5
window-padding-y = 2
window-padding-balance = false
window-width = 80
window-height = 25
background-opacity = 1
working-directory = home
scrollback-limit = 1600000
mouse-reporting = true
bell-features = system,attention,title
confirm-close-surface = false
cursor-style-blink = false
shell-integration-features = no-title
macos-titlebar-style = native
window-theme = dark
keybind = super+left=previous_tab
keybind = super+right=next_tab

